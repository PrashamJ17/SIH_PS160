__pycache__/
*.py[cod]
.venv
.venv/
.venv.nosync/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/
# Transient sweep runtime state. The lock is held only while a sweep runs and names
# the owning PID; committing it would offer a later checkout a lock nobody holds.
data/raw/**/sweep.lock

data/raw/**/*.pcap
data/raw/**/*.pcapng
data/processed/**/*.parquet
data/external/**
!data/**/.gitkeep
*.log
.env
models/*.pkl
models/*.joblib

# macOS
.DS_Store

# Agent/session artifacts, not project deliverables
.claude/

# Demo artefacts are regenerated by run_demo.sh
demo/output/

# Intermediate video assets; the mp4 and transcript are committed, the shots are not
demo/video/shots/

# Report output. The quickstart tells a reader to write reports into the repository
# root, so the obvious first run leaves untracked clutter behind. The reports are
# derived from the bundled captures and are regenerated by re-running the command.
/report.html
/report.json
/report.pdf
/estate.html
/estate.json
/estate.pdf
/change-package/
